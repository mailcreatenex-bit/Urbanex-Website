MONGO_URL="mongodb://localhost:27017"
DB_NAME="urbanex"
# Comma-separated explicit origins (no "*": the API uses credentialed requests)
CORS_ORIGINS="http://localhost:3000"
ADMIN_EMAILS="you@example.com"
EMERGENT_LLM_KEY=""
YOUTUBE_API_KEY=""
YOUTUBE_HANDLE="@urbanexbyayandey"
# International format, digits only
WHATSAPP_NUMBER="919933333333"

# --- Public URLs (used by sitemap, share links and alert emails) ---
PUBLIC_SITE_URL="http://localhost:3000"
# Set when the API is served from a different origin than the request sees (e.g. behind a proxy)
PUBLIC_API_URL=""

# --- Lead / visit alerts (all optional; the CRM bell works without them) ---
# Email: any SMTP provider. Alerts go to ALERT_EMAILS (defaults to ADMIN_EMAILS).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""
ALERT_EMAILS=""
# Webhook: POSTs {"text","content","title","body"} - works with Slack, Discord, Zapier, Make,
# or a WhatsApp gateway you configure.
ALERT_WEBHOOK_URL=""

# --- Site-visit scheduling (India time) ---
VISIT_START_HOUR="10"
VISIT_END_HOUR="18"
# Comma-separated weekdays with no visits, 0=Mon ... 6=Sun (e.g. "6" for Sundays)
VISIT_CLOSED_WEEKDAYS=""

# --- Video calls for NRIs (IST window) ---
VIDEO_START_HOUR="8"
VIDEO_END_HOUR="22"

# --- Weekly digest ---
# Sent automatically once a week (0=Mon ... 6=Sun) after this IST hour. Needs SMTP_* above for email.
DIGEST_WEEKDAY="0"
DIGEST_HOUR="9"
# Optional WhatsApp gateway: receives POST {"to": "<phone>", "text": "<digest>"} for subscribers who opted in.
DIGEST_WEBHOOK_URL=""

# --- YouTube auto-sync ---
# YOUTUBE_API_KEY + YOUTUBE_HANDLE (above) are required. New uploads are checked every N minutes;
# the whole back catalogue is re-checked once a day. Set the channel id if the handle lookup fails.
YOUTUBE_SYNC_MINUTES="10"
YOUTUBE_CHANNEL_ID=""

# --- Bot check (Cloudflare Turnstile, free) ---
# Create a widget at https://dash.cloudflare.com/?to=/:account/turnstile and put the SECRET key here and the
# SITE key in frontend/.env (REACT_APP_TURNSTILE_SITE_KEY). Leave empty to switch the check off.
TURNSTILE_SECRET_KEY=""
# Salt for the hashed network address used to spot repeated entries (set any random string)
IP_HASH_SALT="change-me"

# YouTube without an API key: the newest ~15 uploads are read from the channel's public feed automatically
# (set YOUTUBE_PUBLIC_FEED=0 to turn that off). With YOUTUBE_API_KEY the whole back catalogue is imported.
YOUTUBE_PUBLIC_FEED="1"

# --- Push notifications (Web Push) ---
# Generated automatically on first start and kept in the database. To make them permanent, copy the values
# shown in Admin > Push alerts here (or generate your own pair) and keep the private key secret.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:you@example.com"

# --- AI search over video descriptions (Google Gemini) ---
# Key from Google AI Studio (aistudio.google.com/apikey). This is NOT the YouTube key.
# New/changed descriptions are read automatically (a few at a time, free-tier friendly); searches the rules cannot satisfy are
# interpreted by Gemini and cached. Leave empty to keep rule-based search only.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-flash-latest"
# Tried in order if the main model is overloaded; calls per day are capped.
GEMINI_FALLBACK_MODELS="gemini-flash-lite-latest,gemini-3.5-flash"
GEMINI_DAILY_LIMIT=3000
# Automatic blog: on/off, how often and draft-vs-publish are changed in Admin > Guides & blog.
# Tip: restrict both Google keys in Google Cloud (API restriction; YouTube key by server IP) and rotate any key ever pasted in chat.

# CRM call recordings (see docs/CALL_RECORDING.md)
# Phone-system webhook: set a long random secret, then send it as the X-Webhook-Key header.
CALL_WEBHOOK_SECRET=""
# Google Drive folder of recordings, read with a service account (share the folder with its e-mail address).
DRIVE_CALLS_FOLDER_ID=""
GOOGLE_SERVICE_ACCOUNT_JSON_FILE=""
DRIVE_POLL_SECONDS=120

# CRM lead sources (see docs/LEAD_SOURCES.md). Every one is optional; leave empty to keep it off.
# 99acres / MagicBricks / Housing e-mails forwarded to the webhook: send this secret as the X-Inbox-Key header.
INBOX_SECRET=""
# ...or let the server read a mailbox itself (use an app password, never your main password).
IMAP_HOST=""
IMAP_USER=""
IMAP_PASSWORD=""
IMAP_FOLDER="INBOX"
# Facebook / Instagram lead forms
META_VERIFY_TOKEN=""
META_APP_SECRET=""
META_PAGE_TOKEN=""
# WhatsApp Business Cloud API: needed for receiving chats and for sending messages by themselves
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_ID=""
WHATSAPP_VERIFY_TOKEN=""
WHATSAPP_APP_SECRET=""
# Weekly report and briefing e-mail recipients, comma separated
REPORT_EMAILS=""
