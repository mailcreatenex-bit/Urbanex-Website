#!/bin/sh
# Blocks commits that contain API keys or env files. Enable with: git config core.hooksPath .githooks
for PY in python3 python py; do
  if "$PY" -c "import sys" >/dev/null 2>&1; then exec "$PY" scripts/scan_secrets.py --staged; fi
done
echo "pre-commit: no working Python found, cannot scan for secrets" >&2
exit 1
